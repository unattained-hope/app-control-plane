# Copy to .env on the OCI VM and chmod 600. Never commit .env.
CONTROL_PLANE_DOMAIN=admin.saleswitch.cc

# Existing Caddy network on the shared OCI VM. The production app joins it only
# for HTTP proxying; its PostgreSQL and Redis remain on the private default network.
EDGE_DOCKER_NETWORK=oci-staging_default

# Dedicated control-plane production database.
POSTGRES_USER=control_plane
POSTGRES_PASSWORD=replace-with-a-long-random-production-password
POSTGRES_DB=control_plane

# Read-only SaleSwitch database path exposed through the GCP-side Cloud SQL Auth
# Proxy on its Tailscale address (run-book section 19.3/19.4).
SALESWITCH_REPLICA_URL=postgresql://saleswitch_control_plane:REPLACE_PASSWORD@100.101.142.112:5433/saleswitch?schema=public&connection_limit=3

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
CHAT_HOST_ORIGINS=https://saleswitch.cc
SENTRY_DSN=

FEATURE_FLAGS_READ_TOKEN=
BADGE_GRAPHIC_READ_TOKEN=
SALESWITCH_ADMIN_API_URL=
SALESWITCH_ADMIN_API_TOKEN=
SALESWITCH_INTERNAL_API_URL=https://saleswitch.cc
SALESWITCH_INTERNAL_API_SECRET=

# Optional deployment overrides.
BACKUP_RETENTION_COUNT=14
